---
import Disclosure from '../react/Disclosure';
import { businessInfo } from '../../data/business';
import { primaryNavigation } from '../../data/navigation';
---

<header class="site-header">
  <div class="site-header__bar container">
    <a class="site-header__brand" href="#main-content">
      <span class="site-header__wordmark">{businessInfo.name}</span>
      <span class="site-header__subtitle">Institut de beauté · {businessInfo.city}</span>
    </a>

    <nav class="site-header__nav" aria-label="Navigation principale">
      <ul>
        {primaryNavigation.map((item) => (
          <li><a href={item.href}>{item.label}</a></li>
        ))}
      </ul>
    </nav>

    <a
      class="button button--primary site-header__cta"
      href={businessInfo.planityUrl}
      target="_blank"
      rel="noopener noreferrer"
    >
      Réserver sur Planity
    </a>

    <div class="site-header__mobile-toggle">
      <Disclosure id="menu-mobile" label="Menu" className="disclosure--nav" client:load>
        <nav aria-label="Navigation mobile">
          <ul>
            {primaryNavigation.map((item) => (
              <li><a href={item.href}>{item.label}</a></li>
            ))}
          </ul>
        </nav>
        <a
          class="button button--primary"
          href={businessInfo.planityUrl}
          target="_blank"
          rel="noopener noreferrer"
        >
          Réserver sur Planity
        </a>
      </Disclosure>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--color-bg-alt);
    border-bottom: 1px solid var(--color-border);
  }

  .site-header__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding-block: var(--space-3);
  }

  .site-header__brand {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: var(--color-ink);
    line-height: 1.1;
  }

  .site-header__wordmark {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: clamp(1.35rem, 2.5vw, 1.75rem);
  }

  .site-header__subtitle {
    font-family: var(--font-sans);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-secondary);
  }

  .site-header__nav ul {
    display: flex;
    gap: var(--space-4);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .site-header__nav a {
    text-decoration: none;
    font-weight: 500;
    font-size: 0.95rem;
  }

  .site-header__nav a:hover,
  .site-header__nav a:focus-visible {
    color: var(--color-clay);
  }

  .site-header__nav,
  .site-header__cta {
    display: none;
  }

  .site-header__mobile-toggle :global(.disclosure--nav) {
    position: relative;
  }

  .site-header__mobile-toggle :global(.disclosure--nav > button) {
    background: transparent;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    padding-inline: var(--space-3);
    font-weight: 700;
  }

  .site-header__mobile-toggle :global(.disclosure--nav > div:not([hidden])) {
    position: absolute;
    right: 0;
    top: calc(100% + var(--space-2));
    z-index: 50;
    min-width: 14rem;
    background: var(--color-bg-alt);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-soft);
    padding: var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .site-header__mobile-toggle :global(.disclosure--nav ul) {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .site-header__mobile-toggle :global(.disclosure--nav a) {
    text-decoration: none;
    font-weight: 500;
  }

  @media (min-width: 61rem) {
    .site-header__nav,
    .site-header__cta {
      display: flex;
    }

    .site-header__mobile-toggle {
      display: none;
    }
  }
</style>
